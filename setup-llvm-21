#!/bin/bash
# file: setup-llvm-21

module --force purge
module load CCconfig gentoo/2023
module load llvm/21.1.5
module load openmpi/5.0.8
module load fftw/3.3.10
module load boost-core/.1.87.0
module load aocl-blas/5.1 
module load rarray/2.8.0
module load gsl/2.8

# install catch2 if not present
module load catch2/3.8.1 || eb --try-toolchain=llvm-compilers,21.1.5 Catch2-3.8.1-GCCcore-14.2.0.eb
module load catch2/3.8.1

if [ $? = 0 ]; then
    
    cat > $(dirname ${BASH_SOURCE})/config.mk <<-EOF
	# file: config.mk
	# generated by: setup-llvm-21

	CC=clang
	CXX=clang++
	MPICXX=mpicxx

	OPTFLAGS=-O3 -flto -march=znver5 -funroll-loops -ffast-math
	WARNFLAGS=-Wall -Wfatal-errors -Wno-unused-function -Wno-nan-infinity-disabled

	CFLAGS=\$(OPTFLAGS) \$(WARNFLAGS)
	CXXFLAGS=-std=c++17 \$(CFLAGS)
	OMPFLAGS=-fopenmp
	LDFLAGS=-O3 -march=znver5 -flto

	CATCH2LIBS=-lCatch2Main -lCatch2

	BLASINCDIR=\$(EBROOTAOCLMINBLAS)/include/blis64
	BLASLIBDIR=\$(EBROOTAOCLMINBLAS)/lib64
	BLASLIBS=-lblis-mt64

	BOOSTLIBS=-lboost_program_options

	GSLLIBS=-lgsl \${BLASLIBS}

	FFTWLIBS=-lfftw3
EOF
fi
